              },
              {
                "name": "organisation_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "device_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "snapshot_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Roku Get Snapshot"
        },
        {
          "info": {
            "name": "Roku Update Snapshot",
            "type": "http"
