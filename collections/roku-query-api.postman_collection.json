                      "value": "application/xml"
                    }
                  ],
                  "cookie": [],
                  "responseTime": null,
                  "body": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<element>\n  <udn>(string)</udn>\n  <serialNumber>(string)</serialNumber>\n  <deviceId>(string)</deviceId>\n  <modelNumber>(string)</modelNumber>\n  <modelName>(string)</modelName>\n  <friendlyDeviceName>(string)</friendlyDeviceName>\n  <softwareVersion>(string)</softwareVersion>\n  <softwareBuild>(string)</softwareBuild>\n  <userDeviceName>(string)</userDeviceName>\n  <wifiMac>(string)</wifiMac>\n  <ethernetMac>(string)</ethernetMac>\n  <networkType>(string)</networkType>\n  <countryCode>(string)</countryCode>\n  <language>(string)</language>\n  <timeZone>(string)</timeZone>\n  <powerMode>(string)</powerMode>\n  <supportsEcsTextedit>(boolean)</supportsEcsTextedit>\n  <supportsEcsMicrophone>(boolean)</supportsEcsMicrophone>\n  <supportsWakeOnWlan>(boolean)</supportsWakeOnWlan>\n  <developerEnabled>(boolean)</developerEnabled>\n</element>",
                  "createdAt": "2026-10-21T20:14:12.000Z",
