                ],
                "url": {
                  "raw": "{{baseUrl}}/query/device-info",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "query",
                    "device-info"
                  ]
                },
                "description": "Returns metadata about the Roku device including model, serial number, software version, network status, supported features, and user account state."
