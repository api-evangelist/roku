    "_postman_id": "8c960875-fbc6-4d58-ae48-4de63beba953",
    "name": "Roku External Control Protocol (ECP) Key Press API",
    "description": "The External Control Protocol (ECP) is an HTTP-based API exposed on port 8060 of every Roku\nstreaming device on the local network.\n\nContact Support:\n Name: Roku Developer Program",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "createdAt": "2026-10-21T20:13:40.000Z",
    "updatedAt": "2026-10-21T20:13:40.000Z",
    "lastUpdatedBy": "35240",
    "uid": "35240-8c960875-fbc6-4d58-ae48-4de63beba953"
  },
  "item": [
    {
      "name": "keypress",
      "item": [
        {
          "name": "{key}",
          "item": [
            {
              "name": "Roku Press Key",
              "id": "46b2817c-9c02-43fd-8b19-8dcdca4e81a3",
              "protocolProfileBehavior": {
                "disableBodyPruning": true
              },
              "request": {
                "method": "POST",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/keypress/:key",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "keypress",
                    ":key"
                  ],
                  "variable": [
                    {
                      "id": "97d71a8f-0db0-46de-86b6-cfefab4edf3c",
                      "key": "key",
                      "value": "<string>",
                      "description": "(Required) Key name (e.g., Home, Up, Down, Left, Right, Select, Back, Play, Rev, Fwd, InstantReplay, Info, Backspace, Search, Enter, VolumeUp, VolumeDown, VolumeMute, PowerOff, ChannelUp, ChannelDown, InputTuner, InputHDMI1, etc.) or `Lit_<urlencodedchar>` to send a literal text character."
                    }
                  ]
                },
                "description": "Simulates a momentary press-and-release of a remote-control key."
              },
              "response": [
                {
                  "id": "518a12bc-4ccb-4a70-b563-51a787f18014",
                  "name": "Key press accepted",
                  "originalRequest": {
                    "method": "POST",
                    "header": [],
                    "url": {
                      "raw": "{{baseUrl}}/keypress/:key",
                      "host": [
                        "{{baseUrl}}"
                      ],
                      "path": [
                        "keypress",
                        ":key"
                      ],
                      "variable": [
                        {
                          "key": "key"
                        }
                      ]
                    }
                  },
                  "status": "OK",
                  "code": 200,
                  "_postman_previewlanguage": "text",
                  "header": [],
                  "cookie": [],
                  "responseTime": null,
                  "body": null,
                  "createdAt": "2026-10-21T20:13:40.000Z",
