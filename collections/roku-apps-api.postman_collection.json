              "name": "Roku Query Installed Apps",
              "id": "c7008181-2b56-4ebc-956b-582540cd320e",
              "protocolProfileBehavior": {
                "disableBodyPruning": true
              },
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/xml"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/query/apps",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "query",
                    "apps"
                  ]
                },
                "description": "Returns the list of channels (apps) installed on the device with their app ID, name, version, and type."
              },
              "response": [
                {
                  "id": "e63aa0b4-961e-4588-ab98-eaee2f698dc0",
                  "name": "Apps XML list",
