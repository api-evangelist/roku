                  "status": "OK",
                  "code": 200,
                  "_postman_previewlanguage": "xml",
                  "header": [
                    {
                      "key": "Content-Type",
                      "value": "application/xml"
                    }
                  ],
                  "cookie": [],
                  "responseTime": null,
                  "body": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<element>\n  <apps>\n    <id>(string)</id>\n    <type>(string)</type>\n    <version>(string)</version>\n    <subtype>(string)</subtype>\n    <name>(string)</name>\n  </apps>\n  <apps>\n    <id>(string)</id>\n    <type>(string)</type>\n    <version>(string)</version>\n    <subtype>(string)</subtype>\n    <name>(string)</name>\n  </apps>\n</element>",
