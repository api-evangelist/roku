                  "variable": [
                    {
                      "id": "8ac5fef3-5c02-4e18-83a8-0fa24d7f0a7f",
                      "key": "appId",
                      "value": "<string>",
                      "description": "(Required) The Roku channel/app identifier (or `dev` for the side-loaded developer channel)"
                    }
                  ]
                },
                "description": "Launches the specified installed app. Optional `contentId` and `mediaType` query parameters provide deep-link parameters delivered to the app on launch."
